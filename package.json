{
  "name": "localhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:pino": "npm run test:pino:unit && npm run test:pino:regression",
    "prebuild": "npm run test:pino",
    "test:pino:unit": "node --experimental-strip-types --test tests/pino-understanding.test.mjs tests/pino-gift-retrieval.test.mjs tests/pino-greetings.test.mjs",
    "test:pino:regression": "node scripts/run-pino-regression-tests.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@supabase/ssr": "^0.12.3",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
