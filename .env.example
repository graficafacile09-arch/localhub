# ─────────────────────────────────────────────────────────────
# InCittà — Environment example
#
# Copia questo file in `.env.local` per lo sviluppo locale:
#   cp .env.example .env.local
#
# I valori reali (chiavi, token, secret) vanno inseriti SOLO
# localmente oppure nell'ambiente di deploy (es. Vercel).
# Non committare mai valori reali.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Required · local & production
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Required · local & production
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Required (server-side only) · local & production
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email (Resend) ──────────────────────────────────────────
# Required se le email sono attive · local & production
RESEND_API_KEY=your-api-key-here
# Required se le email sono attive · local & production
RESEND_FROM_EMAIL=noreply@incitta.online
# Optional · toggle email richiesta informazioni · local & production
RICHIESTA_INFO_EMAIL_ENABLED=true
# Optional · toggle email prenotazioni · local & production
PRENOTAZIONI_EMAIL_ENABLED=true

# ── Pagamenti / Stripe ──────────────────────────────────────
# Required (pagamenti) · server-side · production
PAYMENTS_ENCRYPTION_KEY=your-secret-here
# Required se Stripe Connect è attivo · production
STRIPE_SECRET_KEY=your-secret-here
# Required se Stripe Connect è attivo · production
STRIPE_CONNECT_CLIENT_ID=your-client-id-here
# Required se i webhook Stripe sono attivi · production
STRIPE_WEBHOOK_SECRET=your-secret-here
# Optional · override endpoint API Stripe (solo test/mock locale)
STRIPE_API_HOST=localhost
STRIPE_API_PORT=12111
STRIPE_API_PROTOCOL=http
# Optional · override endpoint gateway (default prod/playground nel codice)
KLARNA_API_BASE_URL=
PAYPAL_API_BASE_URL=
SCALAPAY_API_BASE_URL=
# Required se PayPal Multiparty (seller onboarding) è attivo · server-side · production
PAYPAL_PARTNER_CLIENT_ID=your-client-id-here
# Required se PayPal Multiparty (seller onboarding) è attivo · server-side · production
PAYPAL_PARTNER_SECRET=your-secret-here
# Required se i webhook PayPal (Multiparty) sono attivi · server-side · production
PAYPAL_WEBHOOK_ID=your-webhook-id-here

# ── Cron ────────────────────────────────────────────────────
# Required se i job cron sono attivi · production
CRON_SECRET=your-secret-here

# ── Notifiche ntfy ──────────────────────────────────────────
# Optional · "false" disattiva (default attivo) · local & production
NTFY_ENABLED=true
# Optional · default https://ntfy.sh · local & production
NTFY_SERVER_URL=https://ntfy.sh
# Required se ntfy è attivo · production
NTFY_ORDERS_TOPIC=your-topic-here
# Optional · topic admin reclami · production
NTFY_ADMIN_TOPIC=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────
# Optional · toggle canale WhatsApp · local & production
WHATSAPP_ENABLED=true
# Required se WhatsApp è attivo · production
WHATSAPP_ACCESS_TOKEN=your-token-here
# Required se WhatsApp è attivo · production
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
# Optional · versione API (default nel codice)
WHATSAPP_API_VERSION=v21.0

# ── AI / Vision ─────────────────────────────────────────────
# Optional · Gemini text/vision · local & production
GEMINI_API_KEY=your-api-key-here
# Optional · default gemini-2.0-flash · local & production
GEMINI_MODEL=gemini-2.0-flash
# Optional · provider primario riconoscimento prodotti · production
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
# Optional · provider primario riconoscimento prodotti · production
CLOUDFLARE_API_TOKEN=your-api-token-here
# Optional · provider fallback vision / assistente AI · local & production
OPENROUTER_API_KEY=your-api-key-here
# Optional · default qwen/qwen2.5-vl-72b-instruct
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct
# Optional · trascrizione audio · local & production
GROQ_API_KEY=your-api-key-here
# Optional · modello assistente AI (default openrouter/auto)
ADMIN_ASSISTANT_MODEL=openrouter/auto
# Optional · modello trascrizione audio
TRASCRIZIONE_AUDIO_MODEL=

# ── Sicurezza / accesso ordini ──────────────────────────────
# Optional · firma token accesso ordine (fallback: SUPABASE_SERVICE_ROLE_KEY) · local & production
ORDER_ACCESS_TOKEN_SECRET=your-secret-here

# ── Rate limiting ───────────────────────────────────────────
# Optional · default 60 scan/minuto · local & production
RATE_LIMIT_PER_MINUTE=60
# Optional · default 1000 scan/ora · local & production
RATE_LIMIT_PER_HOUR=1000
# Optional · default 6 ordini/minuto · local & production
ORDINI_RATE_LIMIT_PER_MINUTE=6
# Optional · default 40 ordini/ora · local & production
ORDINI_RATE_LIMIT_PER_HOUR=40
# Optional · display rate limit scansioni (default 60/1000) · local & production
NEXT_PUBLIC_RATE_LIMIT_MIN=60
# Optional · display rate limit scansioni (default 60/1000) · local & production
NEXT_PUBLIC_RATE_LIMIT_HOUR=1000

# ── Sito ────────────────────────────────────────────────────
# Optional · URL canonico del sito · local & production
NEXT_PUBLIC_SITE_URL=https://www.incitta.online
# Optional · email admin (ruoli, dev/bootstrap) · local & production
NEXT_PUBLIC_ADMIN_EMAIL=admin@incitta.online

# ── Vercel ──────────────────────────────────────────────────
# Auto-assegnata da Vercel in deploy · non necessaria localmente
VERCEL_URL=